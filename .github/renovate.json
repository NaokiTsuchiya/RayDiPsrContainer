{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:best-practices"
  ],
  "ignorePresets": [
    "helpers:pinGitHubActionDigests"
  ],
  "baseBranchPatterns": [
    "0.x"
  ],
  "labels": [
    "dependencies",
    "renovate"
  ],
  "lockFileMaintenance": {
    "enabled": true,
    "automerge": true
  },
  "packageRules": [
    {
      "description": "GitHub Actions の自動マージ",
      "matchManagers": [
        "github-actions"
      ],
      "automerge": true
    },
    {
      "description": "Coding Standard tools",
      "matchFileNames": [
        "vendor-bin/**"
      ],
      "matchPackageNames": [
        "doctrine/coding-standard",
        "squizlabs/php_codesniffer"
      ],
      "groupName": "coding-standard",
      "automerge": true
    },
    {
      "description": "PHPStan packages",
      "matchFileNames": [
        "vendor-bin/**"
      ],
      "matchPackageNames": [
        "phpstan/phpstan",
        "phpstan/phpstan-phpunit",
        "phpstan/phpstan-strict-rules",
        "phpstan/extension-installer"
      ],
      "groupName": "phpstan-packages",
      "automerge": true
    },
    {
      "description": "Psalm packages（vimeo/psalm のメジャー更新と psalm/plugin-phpunit 0.x 更新を同じ PR にまとめる）",
      "matchFileNames": [
        "vendor-bin/**"
      ],
      "matchPackageNames": [
        "vimeo/psalm",
        "psalm/plugin-phpunit"
      ],
      "groupName": "psalm-packages",
      "separateMajorMinor": false,
      "automerge": true
    },
    {
      "description": "PHPMD",
      "matchFileNames": [
        "vendor-bin/**"
      ],
      "matchPackageNames": [
        "phpmd/phpmd"
      ],
      "automerge": true
    },
    {
      "description": "Rector refactoring tool",
      "matchFileNames": [
        "vendor-bin/**"
      ],
      "matchPackageNames": [
        "rector/rector"
      ],
      "automerge": true
    },
    {
      "description": "composer.json は更新しない（lowest テストのため）",
      "matchFileNames": [
        "composer.json"
      ],
      "enabled": false
    },
    {
      "description": "composer-bin-plugin は更新する",
      "matchFileNames": [
        "composer.json"
      ],
      "matchPackageNames": [
        "bamarni/composer-bin-plugin"
      ],
      "enabled": true
    },
    {
      "description": "新しい PHP バージョンのサポート追加（require.php に \"|| ~8.x\" を追記する。CI マトリクスは composer.json から生成されるため自動で追従する）",
      "matchFileNames": [
        "composer.json"
      ],
      "matchDepTypes": [
        "require"
      ],
      "matchPackageNames": [
        "php"
      ],
      "enabled": true,
      "rangeStrategy": "widen",
      "commitMessageTopic": "PHP version support",
      "automerge": true
    },
    {
      "description": "cs/sa ワークフローの PHP_VERSION 更新を 1 つの PR にまとめる",
      "matchManagers": [
        "custom.regex"
      ],
      "matchPackageNames": [
        "containerbase/php-prebuild"
      ],
      "groupName": "PHP version for CI tools",
      "automerge": true
    }
  ],
  "customManagers": [
    {
      "description": "ワークフローの PHP_VERSION（cs/sa 用）を最新の PHP マイナーバージョンに更新する",
      "customType": "regex",
      "managerFilePatterns": [
        "/^\\.github/workflows/[^/]+\\.ya?ml$/"
      ],
      "matchStrings": [
        "PHP_VERSION: '(?<currentValue>\\d+\\.\\d+)'"
      ],
      "depNameTemplate": "php",
      "datasourceTemplate": "github-tags",
      "packageNameTemplate": "containerbase/php-prebuild",
      "extractVersionTemplate": "^(?<version>\\d+\\.\\d+)\\.\\d+$",
      "versioningTemplate": "loose"
    }
  ]
}
